(rule
 (alias render)
 (deps
  (source_tree skills)
  harnesses.json
  VERSION
  README.md)
 (action
  (progn
   (run %{bin:yap} check --root .)
   (run %{bin:yap} render --root . --all --out rendered)
   (run
    %{bin:yap}
    plugin
    --root
    .
    --harness
    pi,claude,codex,muse
    --out
    rendered-plugin))))
