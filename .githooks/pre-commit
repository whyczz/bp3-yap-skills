#!/bin/sh
# Install with ./scripts/install-hooks.sh.
set -eu
cd "$(git rev-parse --show-toplevel)"
log=$(mktemp "${TMPDIR:-/tmp}/yap-pre-commit.XXXXXX")
trap 'rm -f -- "$log"' EXIT
if make check > "$log" 2>&1; then
  printf 'pre-commit: checks passed\n'
else
  status=$?
  printf 'pre-commit: checks failed\n' >&2
  cat "$log" >&2
  exit "$status"
fi
